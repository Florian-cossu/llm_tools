{
  "name": "llm-tools",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "tools/*",
    "tools/shared/*",
    "control_panel"
  ],
  "keywords": [
    "harness",
    "lm-studio"
  ],
  "scripts": {
    "test": "rm -rf node_modules && node scripts/check-docs.mjs && bun install && bun run typecheck && node scripts/check-deps.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p control_panel",
    "check:docs": "node scripts/check-docs.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "deps:reset": "rm -rf node_modules tools/*/node_modules bun.lock && bun install",
    "setup": "node scripts/setup-tools.mjs --write",
    "start:github": "bun run tools/github/src/index.ts",
    "migrate": "bun run data/migrate.ts",
    "dev:panel": "bun run --cwd control_panel dev",
    "rehome:panel": "node scripts/rehome-panel-deps.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "octokit": "^5.0.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bun-types": "^1.4.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
