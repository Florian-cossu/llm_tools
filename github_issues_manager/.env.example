# All values are optional: without a token the server reads public
# repositories anonymously, and without defaults the caller must pass
# owner and repository on every call.

# Personal access token. Needed for private repositories, and lifts the
# anonymous rate limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Your own GitHub login, for example octocat. This is what the server
# substitutes when the model asks for the "@me" assignee, so that "list my
# issues" resolves to you.
GITHUB_DEFAULT_USERNAME=

# Owner (user or organisation) of the repository to work with by default.
# Must match GITHUB_DEFAULT_REPOSITORY.
GITHUB_DEFAULT_OWNER=

# Repository to work with by default, name only, without the owner prefix.
GITHUB_DEFAULT_REPOSITORY=
