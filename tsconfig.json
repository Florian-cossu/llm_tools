{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@llm-tools/shared": ["./tools/shared/src/index.ts"],
      "@llm-tools/data": ["./data/access.ts"]
    },
    "types": ["bun-types"]
  },
  "exclude": ["control_panel"]
}
