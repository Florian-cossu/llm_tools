# The github token is required to be able to perform requests on the Github API
GITHUB_TOKEN=

# Those tokens are not mandatory and can be setup if you want a default configuration
GITHUB_DEFAULT_USERNAME=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPOSITORY=

# Write tools are off unless this is set (1, true, yes or on). Leave it
# empty and the server registers only its read-only tools - see ADR-0007.
GITHUB_ALLOW_WRITES=
