# The github token is required to be able to perform requests on the Github API
GITHUB_TOKEN=

# Resolves the "@me" sentinel in search queries. Optional.
GITHUB_DEFAULT_USERNAME=

# The default owner/repository are no longer set here - they come from
# whichever `github_profiles` row is active, edited through the control panel
# (`bun run dev:panel`). Add a profile and toggle it active instead of setting
# GITHUB_DEFAULT_OWNER/GITHUB_DEFAULT_REPOSITORY.

# Whether a write or destructive tool registers is no longer controlled here -
# it's a per-tool decision in the permission table, also edited through the
# control panel. See ADR-0007, ADR-0008 and ADR-0009.
